# Generated by scripts/package_linux.py with the release archive's SHA-256.
# A local copy of the source archive beside PKGBUILD permits offline builds.
pkgname=nodavira
pkgver=@VERSION@
pkgrel=1
pkgdesc='Local DNS benchmark with UDP, DoH, DoT and a GTK desktop interface'
arch=('any')
url='https://github.com/saintluc4/nodavira'
license=('MIT')
depends=('python>=3.11' 'python-dnspython>=2.8' 'python-httpx>=0.28'
         'python-h2>=4.3' 'python-pywebview>=6.2.1' 'python-gobject'
         'python-cairo' 'gtk3' 'webkit2gtk-4.1' 'ca-certificates' 'xdg-utils')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

check() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m unittest discover -s tests -v
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    python scripts/package_linux.py --stage "$pkgdir"
}
